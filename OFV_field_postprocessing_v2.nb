       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ys", "=", 
      RowBox[{"field", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xRange", "=", 
      RowBox[{"MinMax", "@", "xs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"yRange", "=", 
      RowBox[{"MinMax", "@", "ys"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"omegaZ", "[", 
       RowBox[{
        RowBox[{"x_", "?", "NumericQ"}], ",", 
        RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", 
         RowBox[{"field", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}], "-", 
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", 
         RowBox[{"field", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"omegaArray", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Quiet", "@", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"omegaZ", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", "Indeterminate"}], "]"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"y", ",", "ys"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xs"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"omegaValues", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Flatten", "@", "omegaArray"}], ",", 
        RowBox[{"_", "?", "NumericQ"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"omegaRange", "=", 
      RowBox[{"MinMax", "@", "omegaValues"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Legended", "[", "\[IndentingNewLine]", 
        RowBox[{"#", ",", 
         RowBox[{"BarLegend", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"ColorData", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<RedBlueTones\>\"", ",", "\"\<Reversed\>\""}], 
               "}"}], "]"}], ",", "omegaRange"}], "\[IndentingNewLine]", 
            "}"}], ",", "15", ",", 
           RowBox[{"LegendMarkerSize", "\[Rule]", "275"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"LabelStyle", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"fontSize", ",", "Black", ",", "Bold"}], "}"}]}], ",", 
           RowBox[{"LegendLabel", "\[Rule]", "legendVorticity"}]}], 
          "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], "&"}],
       "@", 
      RowBox[{"ListDensityPlot", "[", "\[IndentingNewLine]", 
       RowBox[{"omegaArray", ",", 
        RowBox[{"DataRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"xRange", ",", "yRange"}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"InterpolationOrder", "\[Rule]", "0"}], ",", 
        RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
        RowBox[{"ColorFunction", "\[Rule]", 
         RowBox[{"ColorData", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<RedBlueTones\>\"", ",", "\"\<Reversed\>\""}], "}"}], 
          "]"}]}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", "frameLabelCoordinates"}], ",", 
