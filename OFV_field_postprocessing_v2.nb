         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xs"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", "ys"}], "}"}]}], "]"}]}], ";", "\n", "     ", 
