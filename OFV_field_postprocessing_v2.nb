Cell[BoxData[
 RowBox[{
  RowBox[{"getVorticityListPlot", "[", "field_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "xs", ",", "ys", ",", "xRange", ",", "yRange", ",", "omegaZ", ",", 
      "omegaArray", ",", "omegaValues", ",", "omegaRange"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xs", "=", 
