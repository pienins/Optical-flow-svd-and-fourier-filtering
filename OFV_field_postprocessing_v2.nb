Cell[BoxData[
 RowBox[{
  RowBox[{"getInterpolatedVelocityField", "[", "data_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "pts", ",", "vxVals", ",", "vyVals", ",", "vxData", ",", "vyData", ",", 
      "xs", ",", "ys", ",", "\[IndentingNewLine]", "vxAssoc", ",", "vyAssoc", 
      ",", "vxArray", ",", "vyArray"}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\n", "     ", 
     RowBox[{"vxVals", "=", 
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2", ",", "1"}], "]"}], "]"}]}], ";", "\n", 
     "     ", 
