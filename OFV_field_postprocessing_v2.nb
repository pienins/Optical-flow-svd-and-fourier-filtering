Cell[BoxData[
 RowBox[{
  RowBox[{"getDivergenceListPlot", "[", "field_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "xs", ",", "ys", ",", "xRange", ",", "yRange", ",", "divU", ",", 
      "divArray", ",", "divValues", ",", "divRange"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xs", "=", 
      RowBox[{"field", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ys", "=", 
      RowBox[{"field", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xRange", "=", 
      RowBox[{"MinMax", "@", "xs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"yRange", "=", 
      RowBox[{"MinMax", "@", "ys"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"divU", "[", 
       RowBox[{
        RowBox[{"x_", "?", "NumericQ"}], ",", 
        RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", 
         RowBox[{"field", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", 
         RowBox[{"field", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"divArray", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Quiet", "@", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"divU", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", "Indeterminate"}], "]"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"y", ",", "ys"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xs"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"divValues", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Flatten", "@", "divArray"}], ",", 
        RowBox[{"_", "?", "NumericQ"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"divRange", "=", 
      RowBox[{"MinMax", "@", "divValues"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Legended", "[", "\[IndentingNewLine]", 
        RowBox[{"#", ",", 
         RowBox[{"BarLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ColorData", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<RedBlueTones\>\"", ",", "\"\<Reversed\>\""}], 
               "}"}], "]"}], ",", "divRange"}], "}"}], ",", "15", ",", 
           RowBox[{"LegendMarkerSize", "\[Rule]", "275"}], ",", 
           RowBox[{"LabelStyle", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"fontSize", ",", "Black", ",", "Bold"}], "}"}]}], ",", 
           RowBox[{"LegendLabel", "\[Rule]", 
            RowBox[{
            "getLatexStyling", "@", 
             "\"\<\\\\nabla \\\\cdot \\\\vec{u}, \
\\\\textbf{frame}^{-1}\>\""}]}]}], "]"}]}], "\[IndentingNewLine]", "]"}], 
       "&"}], "@", 
      RowBox[{"ListDensityPlot", "[", 
       RowBox[{"divArray", ",", 
        RowBox[{"DataRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"xRange", ",", "yRange"}], "}"}]}], ",", 
        RowBox[{"InterpolationOrder", "\[Rule]", "0"}], ",", 
        RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
        RowBox[{"ColorFunction", "\[Rule]", 
         RowBox[{"ColorData", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<RedBlueTones\>\"", ",", "\"\<Reversed\>\""}], "}"}], 
          "]"}]}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", "frameLabelCoordinates"}], ",", 
        RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", "divRange"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", 
         RowBox[{"Scaled", "@", "1"}]}], ",", 
        RowBox[{"LabelStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"Black", ",", "Bold", ",", "16"}], "}"}]}], ",", 
        RowBox[{"Mesh", "\[Rule]", "None"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
