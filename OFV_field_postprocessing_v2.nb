Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getFormattedData", "[", "dataFile_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dataRaw", ",", "maxYvalue"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dataRaw", "=", 
       RowBox[{"Normal", "/@", 
        RowBox[{"Import", "[", 
         RowBox[{"dataFolder", "<>", "$PathnameSeparator", "<>", "dataFile"}],
          "]"}]}]}], ";", "\[IndentingNewLine]", "\n", "     ", 
      RowBox[{"maxYvalue", "=", 
       RowBox[{"Max", "@", 
        RowBox[{"dataRaw", "[", "\"\<y\>\"", "]"}]}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#1", ",", 
              RowBox[{"maxYvalue", "-", "#2"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"#3", ",", "#4"}], "}"}]}], "}"}], "&"}], "@@", "#"}], 
        "&"}], "/@", 
       RowBox[{"Transpose", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"dataRaw", "[", "#", "]"}], "&"}], "/@", 
         RowBox[{"{", 
          RowBox[{
          "\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<u\>\"", ",", "\"\<v\>\""}],
           "}"}]}], "\[IndentingNewLine]", "]"}]}]}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]], "Input",
