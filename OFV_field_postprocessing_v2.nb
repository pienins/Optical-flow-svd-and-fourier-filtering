      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2", ",", "2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"vxData", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"pts", ",", "vxVals"}], "}"}]}], "]"}]}], ";", "\n", "     ", 
     RowBox[{"vyData", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"pts", ",", "vyVals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"xs", "=", 
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"pts", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}]}], ";", "\n", 
     "     ", 
     RowBox[{"ys", "=", 
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"pts", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\n", "     ", 
     RowBox[{"vxAssoc", "=", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"pts", "\[Rule]", "vxVals"}], "]"}]}], ";", "\n", "     ", 
     RowBox[{"vyAssoc", "=", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"pts", "\[Rule]", "vyVals"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\n", "     ", 
     RowBox[{"vxArray", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
